from itertools import groupby
from collections import defaultdict


class Grouper:
    def __init__(self,iterable, key):
        self.key = key
        self.iterable = sorted(iterable, key=key)
        self.res = defaultdict(list)
        for k, g in groupby(self.iterable, key=key):
            self.res[k].extend(g)
    def __iter__(self):
        return iter(self.res.items())

    def __getitem__(self,key):
        return self.res[key]

    def __contains__(self,key):
        return key in self.res

    def __len__(self):
        return len(self.res)

    def add(self,value):
        for k, g in groupby([value], key=self.key):
            self.res[k].extend(g)
    def group_for(self,value):
        for k, g in groupby([value], key=self.key):
            return k


